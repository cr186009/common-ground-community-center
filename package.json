{
  "name": "paulding-polk-digital-community-center",
  "version": "2.1.0",
  "private": true,
  "description": "Local civic and community hub for Paulding County and Polk County, Georgia.",
  "scripts": {
    "sources:sync": "tsx scripts/sync-scraper-sources.ts",
    "sources:rescan-plan": "node --import tsx scripts/plan-managed-rescan.ts",
    "sources:cleanup": "tsx scripts/cleanup-sources.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test $(find tests src -name '*.test.ts' -type f)",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "scrape": "node --import tsx scripts/scrape.ts",
    "scrape:due": "node --import tsx scripts/scrape-due.ts",
    "scrape:health": "node --import tsx scripts/check-source-health.ts",
    "events:send-reminders": "node --import tsx scripts/send-event-reminders.ts",
    "cleanup:mvp": "node --import tsx scripts/cleanup-mvp-data.ts",
    "cleanup:production": "node --import tsx scripts/cleanup-production-data.ts",
    "meetings:backfill": "node --import tsx scripts/backfill-government-meetings.ts",
    "meetings:repair-paulding-times": "node --import tsx scripts/repair-paulding-meeting-times.ts",
    "events:audit": "node --import tsx scripts/audit-event-quality.ts",
    "events:audit-dates": "node --import tsx scripts/audit-event-dates.ts",
    "events:audit-verification": "node --import tsx scripts/audit-event-dates.ts",
    "events:backfill-trust": "node --import tsx scripts/backfill-event-trust.ts",
    "qa:baseline": "node --import tsx scripts/audit-qa-baseline.ts",
    "test:meetings": "node --import tsx --test src/server/hub-scrapers/content-classifier.test.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "nextjs",
    "community-events",
    "northwest-georgia",
    "paulding-county",
    "polk-county"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "he": "^1.2.0",
    "lucide-react": "^1.7.0",
    "leaflet": "^1.9.4",
    "motion": "^12.43.0",
    "next": "^16.2.2",
    "node-ical": "^0.27.1",
    "prisma": "^6.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/he": "^1.2.3",
    "@types/node": "^25.5.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
